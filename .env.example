# ==========================================
# Temple Organization - Environment Configuration
# ==========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/temple_org?schema=public"

# App & Better Auth
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-at-least-32-chars-long-better-auth-secret-key-goes-here"

# Initial Seed Admin
INITIAL_ADMIN_EMAIL="admin@temple.org"

# OAuth 2.0 Providers
# Google (Devotees & Staff)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook (Devotees)
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Apple (Devotees)
APPLE_CLIENT_ID="your-apple-service-id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="your-apple-private-key-p8"

# Payments (Razorpay INR)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Transactional Email (Resend)
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="temple@temple.org"

# SMS & OTP (MSG91)
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="TEMPLE"
MSG91_OTP_TEMPLATE_ID="your-msg91-otp-template-id"

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Error Monitoring (Sentry)
SENTRY_DSN="https://placeholder@o000000.ingest.sentry.io/0000000"
